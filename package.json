{
  "name": "local-union-hub",
  "version": "0.1.0",
  "private": true,
  "description": "UnionOps: Practical, privacy-focused management tools built for labour unions and locals. Comms stay free on-device; hosted Officer Hub / Local Portal may recover hosting costs. Stewarded by Ryan Morris. Solidarity.",
  "author": "Ryan Morris",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "@swc/core@1.15.43": true,
    "core-js@3.49.0": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint",
    "check:zoom": "node scripts/check-zoom-guards.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:export": "playwright test --grep @export",
    "test:smoke:sandbox": "node scripts/smoke-sandbox.mjs",
    "health:check": "node scripts/health-check.mjs",
    "health:check:production": "node scripts/verify-prod-health.mjs",
    "health:check:readiness": "node scripts/verify-host-readiness.mjs",
    "package:sandbox": "node scripts/package-sandbox-src.mjs",
    "brand:set": "node scripts/set-host-brand.mjs",
    "brand:favicons": "node scripts/generate-favicons.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:contract:generate": "tsx scripts/generate-db-contract.ts --out docker/db-required-shape.json",
    "db:check": "node scripts/check-db-migrations.mjs && tsx scripts/generate-db-contract.ts --check --out docker/db-required-shape.json",
    "db:deploy": "node docker/db-deploy.mjs",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:seed-admin": "tsx src/lib/db/seed-admin.ts",
    "db:studio": "drizzle-kit studio",
    "db:rls-smoke": "tsx scripts/rls-smoke.ts",
    "db:durability-smoke": "tsx scripts/durability-smoke.ts",
    "db:customization-rls": "node scripts/customization-rls-smoke.mjs",
    "db:customization-durability": "tsx scripts/customization-durability-smoke.ts",
    "db:customization-upgrade": "node scripts/customization-upgrade-smoke.mjs",
    "db:portal-durability-smoke": "tsx scripts/portal-durability-smoke.ts",
    "db:portal-upgrade-smoke": "tsx scripts/portal-upgrade-smoke.ts",
    "db:portal-process-restart-smoke": "tsx scripts/portal-process-restart-smoke.ts",
    "db:demo-purge": "tsx scripts/demo-purge.ts",
    "ops:verify-durable": "node scripts/verify-durable-local.mjs",
    "copy:readability": "tsx scripts/copy-readability.ts",
    "fonts:sync-ttf": "node scripts/sync-canvas-font-ttf.mjs",
    "office:verify:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-office-windows.ps1",
    "office:fixtures": "tsx scripts/generate-office-smoke.ts",
    "pdf:preview": "node scripts/pdf-preview.mjs",
    "test:union-audit": "vitest run src/lib/audit/union-audit-guards.test.ts src/lib/officer-learning/inline-markdown.test.ts",
    "test:external-links": "node scripts/check-external-links.mjs",
    "test:union-audit:e2e": "playwright test e2e/union-audit.site.spec.ts e2e/officer-learning.quiz.audit.spec.ts --grep @smoke"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1094.0",
    "@sentry/nextjs": "^10.73.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "docxtemplater": "^3.69.0",
    "docxtemplater-image-module-free": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.13.1",
    "nodemailer": "^7.0.13",
    "pdfjs-dist": "^6.1.200",
    "pizzip": "^3.2.0",
    "postgres": "^3.4.9",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wawoff2": "^2.0.1"
  }
}
