{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "viewport-lab-recipe",
  "type": "object",
  "required": ["id", "title", "startUrl", "steps"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "startUrl": { "type": "string", "pattern": "^/viewport-lab/" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "preset",
              "checkOverflow",
              "setLocale",
              "navigate",
              "runAxe",
              "note"
            ]
          },
          "id": { "type": "string" },
          "locale": { "type": "string", "enum": ["en", "fr"] },
          "path": { "type": "string" },
          "text": { "type": "string" },
          "expectHorizontalPxMax": { "type": "number" },
          "colorContrast": { "type": "boolean" }
        }
      }
    }
  }
}
