# Copy to docker/.env and fill secrets before `docker compose up`.
# Durable CapRover / production flip: see .env.production.example and docs/guides/CAPROVER_POSTGRES.md
# Generate: openssl rand -base64 32

AUTH_SECRET=
POSTGRES_PASSWORD=
# Strong password for unionops_app (RLS runtime role). Required for production casework.
POSTGRES_APP_PASSWORD=

# Public URL (no trailing slash)
AUTH_URL=http://localhost:3000

# Optional: flip one module at a time, or use docker-compose.durable.yml for all-at-once.
# GRIEVANCE_DB_BACKEND=postgres
# AUTH_USERS_BACKEND=postgres

# Production casework (recommended with durable overlay):
# AUTH_MFA_ENABLED=true
# AUTH_MFA_MODE=totp
# NEXT_PUBLIC_DEMO_SITE=false
# AUTH_ALLOW_DEMO_USERS=false
