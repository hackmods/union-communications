# Production / CapRover durable Postgres — paste into CapRover App Configs or docker/.env
# with docker-compose.durable.yml. See docs/guides/CAPROVER_POSTGRES.md for the full walkthrough.
#
# Generate secrets:
#   openssl rand -base64 32   # AUTH_SECRET, CRON_SECRET, HOST_READINESS_SECRET
# URL-encode passwords in connection strings if they contain + / @ etc.

# ---------------------------------------------------------------------------
# Required — web app
# ---------------------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=https://unionops.org
# Private bearer access to operator-only fields on GET /api/health. Store the
# same value as the GitHub Actions HOST_READINESS_SECRET for post-deploy checks.
HOST_READINESS_SECRET=

# Owner role — append-only Drizzle migrations + required-shape verification on
# container boot (entrypoint → docker/db-deploy.mjs). Never use in runtime queries.
MIGRATE_DATABASE_URL=postgres://postgres:OWNER_PASSWORD@srv-captain--postgres-unionops:5432/unionops

# App role — runtime RLS. Same password as POSTGRES_APP_PASSWORD below.
DATABASE_URL=postgres://unionops_app:APP_PASSWORD@srv-captain--postgres-unionops:5432/unionops
POSTGRES_APP_PASSWORD=
# Optional: maximum advisory-lock wait in milliseconds (default 120000).
# MIGRATE_LOCK_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Flip all confidential Hub backends to Postgres (mirror docker-compose.durable.yml)
# ---------------------------------------------------------------------------
GRIEVANCE_DB_BACKEND=postgres
BUMPING_DB_BACKEND=postgres
AUDIT_DB_BACKEND=postgres
TIME_DB_BACKEND=postgres
ATTACHMENTS_DB_BACKEND=postgres
DISCUSSIONS_DB_BACKEND=postgres
TASKS_DB_BACKEND=postgres
INFORMAL_LOG_DB_BACKEND=postgres
SNIPPETS_DB_BACKEND=postgres
MINUTES_DB_BACKEND=postgres
LEDGER_DB_BACKEND=postgres
OFFICERS_DB_BACKEND=postgres
TRAVEL_DB_BACKEND=postgres
EXPENSES_DB_BACKEND=postgres
COMMITTEES_DB_BACKEND=postgres
ELECTIONS_DB_BACKEND=postgres
POLLS_DB_BACKEND=postgres
FEEDBACK_DB_BACKEND=postgres
MEETINGS_DB_BACKEND=postgres
MEETINGS_RSVP_DB_BACKEND=postgres
CHECKINS_DB_BACKEND=postgres
AUTH_USERS_BACKEND=postgres
OFFICER_LEARNING_DB_BACKEND=postgres
PLATFORM_SETTINGS_DB_BACKEND=postgres
BYLAWS_DB_BACKEND=postgres
PROPOSALS_DB_BACKEND=postgres
# Beta access / member request flows (migration 0053). Prefers postgres whenever
# DATABASE_URL is set; keep the explicit flag so health/readiness stay obvious.
ACCESS_REQUEST_DB_BACKEND=postgres
# Operator ping for new /join and /request-access submissions (requires EMAIL_ENABLED).
ACCESS_REQUEST_NOTIFY_EMAIL=ryan@ryanmorris.ca
# UnionOps Data workbench — keep memory until the import/review UX gaps close
# (docs/audit/session-knowledge-2026-09-20-unionops-data.md).
DATA_DB_BACKEND=memory

# Local Portal — set postgres once Circles are ready for lasting storage (or
# immediately if Portal was never relied on for real Circles). Leaving this on
# memory keeps the Hub “Memory only” banner even when grievances/time are durable.
# Confirm flips on Site admin → Host readiness (/app/site-admin/host).
PORTAL_DB_BACKEND=postgres

# ---------------------------------------------------------------------------
# Production auth (live casework — not demo hosts)
# ---------------------------------------------------------------------------
AUTH_ALLOW_DEMO_USERS=false
# Fail closed for UnionOps-operated customer instances: protected Hub access
# requires per-user TOTP regardless of the legacy demo-friendly switch.
UNIONOPS_HOSTED_CUSTOMER_MODE=true
AUTH_MFA_ENABLED=true
AUTH_MFA_MODE=totp
# Boot seed (entrypoint after migrate). Default auto = upsert B7P when unions empty.
# SEED_ON_BOOT=auto
# SEED_ON_BOOT=false   # opt out
# SEED_DEMO_USERS=false   # only for one-shot npm run db:seed / caprover-bootstrap-seed.sh
# Do not set MIGRATE_CONTINUE_ON_ERROR on production — ignored when NODE_ENV=production.
#
# Demo cleanup UI/API (/app/site-admin/demo-cleanup). Leave unset/false on live
# production. Set true only on demo/workshop CapRover apps that need is_demo purge.
# SITE_ADMIN_DEMO_PURGE_ENABLED=false

# ---------------------------------------------------------------------------
# CapRover build args (rebuild image — not runtime env)
# NEXT_PUBLIC_* is inlined at build time by Next.js.
# CapRover also passes every App Config as a Docker build-arg. Runtime-only
# keys (DATABASE_URL, *_DB_BACKEND, SMTP_*, …) correctly show as “not
# consumed” — do NOT declare them as Dockerfile ARG (secrets would land in
# image history). Only NEXT_PUBLIC_* / Sentry bake args need ARG+ENV.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_DEMO_SITE=false
# NEXT_PUBLIC_OFFICER_HUB_PUBLIC=true
# NEXT_PUBLIC_EMAIL_ENABLED=true

# ---------------------------------------------------------------------------
# Optional — transactional email (invites, password reset, meeting reminders)
# DigitalOcean CapRover: use MAILGUN_API_* (SMTP 465/587 are blocked).
# ---------------------------------------------------------------------------
# EMAIL_ENABLED=true
# EMAIL_FROM=UnionOps <noreply@unionops.org>
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=unionops.org
# MAILGUN_API_REGION=us
# # Optional SMTP (non-DO or port 2525):
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=2525
# SMTP_USER=
# SMTP_PASS=

# ---------------------------------------------------------------------------
# Optional — cron officer meeting reminders + incident grant cleanup
# GET|POST /api/cron/meeting-reminders  Authorization: Bearer $CRON_SECRET
# GET|POST /api/cron/incident-step-up-cleanup  (expired MFA step-up grants)
# ---------------------------------------------------------------------------
# CRON_SECRET=

# ---------------------------------------------------------------------------
# Optional — operator error sinks (not product analytics; defaults off)
# Client Sentry: bake NEXT_PUBLIC_SENTRY_DSN at image build.
# Server Sentry: SENTRY_ENABLED=true + SENTRY_DSN (or public DSN) at runtime.
# File log: mount Persistent Directory → /data/logs (else lost on redeploy).
# ---------------------------------------------------------------------------
# SENTRY_ENABLED=true
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# ERROR_LOG_FILE_ENABLED=true
# ERROR_LOG_FILE_PATH=/data/logs/unionops-errors.jsonl
# ERROR_LOG_FILE_MAX_BYTES=10485760
# ERROR_LOG_FILE_KEEP=3
# OBSERVABILITY_BACKEND=postgres
# File JSONL is optional dual-write. Postgres via DATABASE_URL is the Docker primary (migration 0082).

# ---------------------------------------------------------------------------
# Optional — attachment files (metadata is in Postgres; mount a persistent volume)
# ---------------------------------------------------------------------------
# ATTACHMENT_STORAGE=local
# ATTACHMENT_LOCAL_DIR=/app/data/attachments
# Or configure S3-compatible storage with bucket, credentials, explicit region,
# and ATTACHMENT_S3_SSE=AES256 (the runtime default). Customer readiness blocks
# until an operator reviews and attests the actual location, encryption, and
# lifecycle settings. The application cannot inspect the provider's policies.
UNIONOPS_ATTACHMENT_STORAGE_APPROVED=false
UNIONOPS_ATTACHMENT_STORAGE_REVIEWED_AT=
UNIONOPS_ATTACHMENT_STORAGE_REVIEWED_BY=

# Use a real scanner in strict mode, with skip-on-error unset/false. Record a
# recent operator test of clean/infected handling and fail-closed behavior.
# ATTACHMENT_SCANNER_URL=
# ATTACHMENT_SCAN_MODE=strict
UNIONOPS_ATTACHMENT_SCAN_TESTED_AT=
UNIONOPS_ATTACHMENT_SCAN_TESTED_BY=

# Operator attestations: the app checks required fields and a maximum age of
# 90 days; it cannot independently verify backup jobs, restores, or alerts.
UNIONOPS_BACKUP_CONFIGURED=false
UNIONOPS_BACKUP_RESTORE_TESTED_AT=
UNIONOPS_BACKUP_OWNER=
UNIONOPS_ALERTS_CONFIGURED=false
UNIONOPS_ALERT_DELIVERY_TESTED_AT=
UNIONOPS_ALERT_OWNER=

# Public identity and role contacts. Verify all addresses are monitored and
# record the latest review date and accountable reviewer. Hosted customer
# readiness blocks until this configuration and its current review exist.
UNIONOPS_LEGAL_ENTITY_NAME=
UNIONOPS_PRIVACY_OFFICER_NAME=
UNIONOPS_PRIVACY_EMAIL=
UNIONOPS_PRIVACY_MAILING_ADDRESS=
UNIONOPS_SECURITY_EMAIL=
UNIONOPS_ACCESSIBILITY_EMAIL=
UNIONOPS_PUBLIC_CONTACTS_MONITORED_AT=
UNIONOPS_PUBLIC_CONTACTS_MONITORED_BY=

# ---------------------------------------------------------------------------
# Debug only — non-production start after a failed gate. Ignored in production.
# ---------------------------------------------------------------------------
# MIGRATE_CONTINUE_ON_ERROR=true
